---
import '@fontsource-variable/jetbrains-mono';
import { getCollection, render } from 'astro:content';

const name = 'Fermín Martínez';
const role = 'Software artisan.';

const projects = (await getCollection('projects'))
	.sort((a, b) => a.data.order - b.data.order);
const description = `Software developer based in Montevideo, Uruguay, building products end to end with a focus on the frontend. Selected work: ${new Intl.ListFormat('en').format(projects.map((p) => p.data.title))}.`;
const url = new URL('/', Astro.site);
const image = new URL('/og.png', Astro.site);
const rendered = await Promise.all(projects.map(async (p) => ({ ...p, Content: (await render(p)).Content })));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{name} · {role.replace(/\.$/, '')}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={url} />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0e0e" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={url} />
		<meta property="og:title" content={name} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${name}, ${role.replace(/\.$/, '')}`} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<header>
			<h1>{name}</h1>
			<p>{role}</p>
		</header>

		<main>
			{rendered.map(({ data, Content }) => (
				<article>
					<div class="head">
						<h2>{data.title}</h2>
						<span class="meta status" data-status={data.status}>{data.status}</span>
					</div>
					<Content />
					{data.stack.length > 0 && <ul class="meta stack">{data.stack.map((s) => <li>{s}</li>)}</ul>}
					{(data.url || data.repo) && (
						<p class="links">
							{data.url && (
								<a href={data.url} target="_blank" rel="noopener noreferrer">
									Visit<span class="sr-only"> {data.title} (opens in a new tab)</span><span aria-hidden="true"> ↗</span>
								</a>
							)}
							{data.repo && (
								<a href={data.repo} target="_blank" rel="noopener noreferrer">
									Source<span class="sr-only"> code of {data.title} (opens in a new tab)</span><span aria-hidden="true"> ↗</span>
								</a>
							)}
						</p>
					)}
				</article>
			))}
		</main>

		<footer>
			<button id="email" type="button" title="Copy email">fer [at] mrtnz [dot] dev</button>
			<span id="email-status" class="sr-only" aria-live="polite"></span>
			<p class="meta" id="clock-row" hidden>America/Montevideo <time id="clock"></time></p>
		</footer>

		<script>
			const email = document.getElementById('email')!;
			const status = document.getElementById('email-status')!;
			const label = email.textContent;
			let reset: number | undefined;
			email.addEventListener('click', async () => {
				clearTimeout(reset);
				try {
					await navigator.clipboard.writeText('fer@mrtnz.dev');
					email.textContent = status.textContent = 'copied to clipboard';
					reset = setTimeout(() => {
						email.textContent = label;
						status.textContent = '';
					}, 1500);
				} catch {
					// Clipboard blocked: show the real address selected, ready for Ctrl/Cmd+C.
					email.textContent = 'fer@mrtnz.dev';
					getSelection()?.selectAllChildren(email);
				}
			});

			const clock = document.getElementById('clock')!;
			const fmt = new Intl.DateTimeFormat('en-GB', {
				timeZone: 'America/Montevideo',
				hour: '2-digit',
				minute: '2-digit',
				second: '2-digit',
				hour12: false,
				fractionalSecondDigits: 3,
			});
			const tick = () => {
				clock.textContent = fmt.format(new Date());
				requestAnimationFrame(tick);
			};
			tick();
			document.getElementById('clock-row')!.hidden = false;
		</script>
	</body>
</html>

<style is:global>
	/* Vertical spacing in rlh (one line of text), horizontal in ch (one character). */
	:root {
		color-scheme: light dark;
		--fg: light-dark(#111, #eee);
		--muted: light-dark(#6b6b6b, #8f8f8f);
		--line: light-dark(#e5e5e5, #2a2a2a);
		font: 14px/1.7 'JetBrains Mono Variable', ui-monospace, monospace;
		color: var(--fg);
		background: light-dark(#fff, #0e0e0e);
		-webkit-text-size-adjust: 100%;
		text-size-adjust: 100%;
	}
	body {
		max-width: 70ch; /* 66ch of text + 2ch padding per side */
		margin: 0 auto;
		padding: 1.5rlh 2ch; /* same space above the header as below the footer */
		min-height: 100svh;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
	}
	h1, h2 { font-size: 1rem; font-weight: 700; margin: 0; }
	p { margin: 0; }
	header p, .meta { color: var(--muted); }
	a { color: inherit; text-underline-offset: 3px; text-decoration-color: var(--line); }
	@media (hover: hover) { a:hover { text-decoration-color: currentColor; } }
	main { margin: min(3rlh, 10svh) 0 3rlh; flex: 1; align-content: start; display: grid; gap: 2.5rlh; }
	article { display: grid; gap: 0.25rlh; }
	.stack { list-style: none; padding: 0; margin: 0; }
	.stack li { display: inline; white-space: nowrap; }
	.stack li:not(:last-child)::after { content: '\a0· '; white-space: normal; }
	.head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 2ch; }
	.status::before { content: ''; display: inline-block; width: 0.5em; height: 0.5em; border-radius: 50%; margin-right: 1ch; vertical-align: 0.1em; background: currentColor; }
	.status[data-status='live']::before { background: light-dark(#16a34a, #4ade80); }
	.status[data-status='in development']::before { background: light-dark(#d97706, #fbbf24); }
	.links { display: flex; gap: 2ch; }
	.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
	footer { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0 2ch; }
	footer > * { white-space: nowrap; }
	#email { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; user-select: text; }
	@media (hover: hover) { #email:hover { text-decoration: underline; text-underline-offset: 3px; } }
	#clock { font-variant-numeric: tabular-nums; margin-left: 1ch; }
</style>
